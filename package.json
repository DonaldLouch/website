{
  "name": "donaldlouch",
  "version": "depreciation.clean",
  "packageManager": "yarn@4.12.0",
  "type": "module",
  "description": "I&#39;m a Canadian digital producer specializing in web development, photography, videography, and more. I hold a Bachelor of Arts in Digital Media Studies and two Graduate Certificates in Digital Communication, and Digital Productions Writing and Design.",
  "private": true,
  "scripts": {
    "dev": "vite dev --port 3000 --host",
    "build": "dotenv -e .env -- prisma generate && tsr generate && vite build",
    "test": "vitest run",
    "update": "yarn upgrade-interactive",
    "db:generate": "dotenv -e .env.local -- prisma generate",
    "db:push": "dotenv -e .env.local -- prisma db push",
    "db:migrate": "dotenv -e .env.local -- prisma migrate dev",
    "db:studio": "dotenv -e .env.local -- prisma studio",
    "db:seed": "dotenv -e .env.local -- prisma db seed"
  },
  "keywords": [
    "Donald Louch, Donald, Louch, Portfolio, Website, Blog, Photography, Videography, Web Production, Canada, Canadian, Digital Content, Content Creator"
  ],
  "author": "Donald Louch<hello@donaldlouch.ca>",
  "license": "MIT",
  "dependencies": {
    "@fontsource-variable/noto-sans": "^5.2.10",
    "@fontsource-variable/noto-sans-mono": "^5.2.10",
    "@fontsource-variable/noto-serif": "^5.2.9",
    "@mantine/core": "^8.3.16",
    "@mantine/hooks": "^9.0.0",
    "@tanstack/react-router": "^1.166.3",
    "@tanstack/react-start": "^1.166.3",
    "@tanstack/router-core": "^1.166.2",
    "@tanstack/start-plugin-core": "^1.166.3",
    "@tanstack/start-server-core": "^1.166.2",
    "react": "19.2.4",
    "react-dom": "19.2.4",
    "vite-plugin-db": "^0.7.0"
  },
  "devDependencies": {
    "@netlify/vite-plugin-tanstack-start": "^1.3.2",
    "@tanstack/devtools-vite": "^0.5.3",
    "@tanstack/router-cli": "^1.166.2",
    "@tanstack/router-plugin": "^1.166.3",
    "@types/react": "19.2.14",
    "@types/react-dom": "19.2.3",
    "@vitejs/plugin-react": "^5.1.4",
    "postcss": "^8.5.8",
    "postcss-preset-mantine": "^1.18.0",
    "postcss-simple-vars": "^7.0.1",
    "vite": "^7.3.1",
    "vite-plugin-mkcert": "^1.17.10",
    "vite-tsconfig-paths": "^6.1.1",
    "vitest": "^4.0.18",
    "web-vitals": "^5.1.0"
  }
